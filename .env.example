APP_ENV=development
LOG_LEVEL=INFO
OPENAI_BASE_URL=https://example.invalid/v1
OPENAI_API_KEY=replace-me
CHAT_MODELS=azure/gpt-5-mini,azure/gpt-6-luna
EMBEDDING_MODEL=cohere/embed-v4.0
QDRANT_URL=https://example.invalid
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=mental-health-v1
DOCUMENTS_DIR=data/documents
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_FOLLOWING_PAGES=1
SESSION_TTL_SECONDS=3600
SESSION_MAX_MESSAGES=12
SESSION_MAX_COUNT=10000
RETRIEVAL_HISTORY_MESSAGES=4
MAX_MESSAGE_LENGTH=4000
MAX_CONCURRENT_STREAMS=32
STREAM_TIMEOUT_SECONDS=60
# Vazio desliga o CORS. No desenvolvimento do frontend React, use
# http://localhost:5173. Em produção, o render.yaml fixa
# https://desafio-albert.vercel.app. Sem asterisco e sem previews.
CORS_ORIGINS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=desafio-albert-chatbot
OTEL_TRACES_SAMPLE_RATIO=1
